# Task 5: Data Analysis on CSV Files
# Objective: Analyze sales data using Pandas

# Step 1: Import libraries
import pandas as pd
import matplotlib.pyplot as plt

# Step 2: Load CSV file
# Replace 'sales.csv' with your actual file name
df = pd.read_csv("sales.csv")

# Step 3: Basic exploration
print("First 5 rows:\n", df.head())
print("\nShape of dataset:", df.shape)
print("\nColumn names:", df.columns)
print("\nSummary statistics:\n", df.describe())
print("\nMissing values:\n", df.isnull().sum())

# Step 4: Grouping & Aggregation
# Example: Total sales per product
sales_by_product = df.groupby("Product")["Sales"].sum()
print("\nSales by Product:\n", sales_by_product)

# Example: Total sales per region
sales_by_region = df.groupby("Region")["Sales"].sum()
print("\nSales by Region:\n", sales_by_region)

# Step 5: Visualization
plt.figure(figsize=(10,5))
sales_by_product.plot(kind="bar", title="Sales by Product")
plt.ylabel("Total Sales")
plt.show()

plt.figure(figsize=(10,5))
sales_by_region.plot(kind="pie", autopct='%1.1f%%', title="Sales by Region")
plt.ylabel("")
plt.show()

# Step 6: Filtering Rows
high_sales = df[df["Sales"] > 1000]
print("\nRows with Sales > 1000:\n", high_sales)

# Step 7: Insights
print("\n--- Insights ---")
print("Top-selling product:", sales_by_product.idxmax(), "with sales:", sales_by_product.max())
print("Region contributing most sales:", sales_by_region.idxmax(), "with sales:", sales_by_region.max())
